<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import javafx.collections.ObservableList?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="1000.0" spacing="20.0" 
      styleClass="past-entries-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mindscribe.ui.PastEntriesViewController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" prefWidth="960.0">
         <children>
            <Button fx:id="btnBack" text="← Back to Dashboard" 
                    styleClass="back-button" onAction="#handleBackToDashboard" />
            <Label text="Past Journal Entries" styleClass="entries-title">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
      
      <!-- Entries Table -->
      <TableView fx:id="entriesTable" styleClass="entries-table" prefHeight="500.0">
         <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120.0" />
            <TableColumn fx:id="moodColumn" text="Mood" prefWidth="100.0" />
            <TableColumn fx:id="previewColumn" text="Preview" prefWidth="400.0" />
            <TableColumn fx:id="analysisColumn" text="Analysis" prefWidth="280.0" />
         </columns>
      </TableView>
      
      <!-- Action Buttons -->
      <HBox alignment="CENTER" spacing="15.0" prefWidth="960.0">
         <children>
            <Button fx:id="btnDeleteSelected" text="🗑️ Delete Selected" 
                    styleClass="delete-button" onAction="#handleDeleteSelected" />
            <Button fx:id="btnExportAll" text="📄 Export All Entries" 
                    styleClass="export-button" onAction="#handleExportAll" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>
