<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="900.0" spacing="30.0" 
      styleClass="dashboard-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mindscribe.ui.DashboardViewController">
   <children>
      <!-- Header -->
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label fx:id="lblGreeting" text="Hello, Shifa!" styleClass="greeting-label">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <Label text="Welcome to your personal journal" styleClass="subtitle-label">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
      
      <!-- Quick Action Buttons -->
      <HBox alignment="CENTER" spacing="40.0">
         <children>
            <!-- Write Today's Diary Button -->
            <VBox alignment="CENTER" spacing="15.0" styleClass="action-card">
               <children>
                  <Label text="✍️" styleClass="action-icon">
                     <font>
                        <Font size="48.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnWriteDiary" text="Write Today's Diary" 
                          styleClass="action-button" prefWidth="200.0" prefHeight="50.0" 
                          onAction="#handleWriteDiary" />
               </children>
            </VBox>
            
            <!-- View Mood Analytics Button -->
            <VBox alignment="CENTER" spacing="15.0" styleClass="action-card">
               <children>
                  <Label text="📊" styleClass="action-icon">
                     <font>
                        <Font size="48.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnViewAnalytics" text="View Mood Analytics" 
                          styleClass="action-button" prefWidth="200.0" prefHeight="50.0" 
                          onAction="#handleViewAnalytics" />
               </children>
            </VBox>
            
            <!-- Past Entries Button -->
            <VBox alignment="CENTER" spacing="15.0" styleClass="action-card">
               <children>
                  <Label text="📜" styleClass="action-icon">
                     <font>
                        <Font size="48.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnPastEntries" text="Past Entries" 
                          styleClass="action-button" prefWidth="200.0" prefHeight="50.0" 
                          onAction="#handlePastEntries" />
               </children>
            </VBox>
            
            <!-- Emergency Contacts Button -->
            <VBox alignment="CENTER" spacing="15.0" styleClass="action-card">
               <children>
                  <Label text="🚨" styleClass="action-icon">
                     <font>
                        <Font size="48.0" />
                     </font>
                  </Label>
                  <Button fx:id="btnEmergencyContacts" text="Emergency Contacts" 
                          styleClass="action-button" prefWidth="200.0" prefHeight="50.0" 
                          onAction="#handleEmergencyContacts" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- Recent Entry Preview -->
      <VBox alignment="CENTER" spacing="15.0" styleClass="preview-card" prefWidth="700.0">
         <children>
            <Label text="Recent Entry" styleClass="preview-title">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label fx:id="lblRecentEntry" text="No recent entries found. Start writing today!" 
                   styleClass="preview-text" wrapText="true" maxWidth="650.0" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      
      <!-- Footer -->
      <HBox alignment="BOTTOM_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnLogout" text="Logout" styleClass="logout-button" 
                    onAction="#handleLogout" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
